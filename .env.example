# Copy this file to ".env" and fill in the values yourself.
# Never paste these values into a chat. ".env" is git-ignored.
# On Railway, the same names go under the service's "Variables" tab.

# Phase 1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=

# Phase 2
ANTHROPIC_API_KEY=

# Phase 3: Gmail over IMAP (read-only), with a Google app password (not the normal password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
